#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
if [[ "$cmd" == "unmount" ]]; then
  exec /usr/bin/python3 "$(dirname "$(readlink -f "$0")")/storage_unmount.py" "${2:?device fehlt}" "${3:?mountpoint fehlt}"
fi

if [[ "$cmd" == "mount" ]]; then
  dev="${2:?device fehlt}"
  mp="${3:?mountpoint fehlt}"
  persist="${4:-1}"

  [[ "$dev" == /dev/* ]] || {
    echo "Ungültiges Gerät" >&2
    exit 2
  }

  [[ "$mp" == /* ]] || {
    echo "Mountpunkt muss absolut sein" >&2
    exit 2
  }

  uuid="$(blkid -s UUID -o value "$dev" || true)"
  fstype="$(blkid -s TYPE -o value "$dev" || true)"

  [[ -n "$uuid" && -n "$fstype" ]] || {
    echo "UUID oder Dateisystem nicht ermittelbar" >&2
    exit 3
  }

  mkdir -p "$mp"

  if [[ "$persist" == "1" ]]; then
    if ! grep -q "UUID=$uuid" /etc/fstab; then
      cp -a /etc/fstab \
        "/etc/fstab.server-manager.$(date +%F_%H-%M-%S).bak"

      echo "UUID=$uuid $mp $fstype defaults,nofail,x-gvfs-show 0 2" \
        >> /etc/fstab
    fi
  fi

  mount "$mp" || mount "$dev" "$mp"

  echo "OK: $dev ($fstype, UUID=$uuid) auf $mp gemountet"
  exit 0
fi


if [[ "$cmd" == "smart-preview" || "$cmd" == "smart-apply" ]]; then
  mode="$cmd"

  exec /usr/bin/python3 - "$mode" <<'PY'
import datetime
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


MODE = sys.argv[1]

SMARTD_CONF = Path("/etc/smartd.conf")
HISTORY_DIR = Path(os.environ.get("SERVER_MANAGER_STATE", "/var/lib/server-manager"))
HISTORY_FILE = HISTORY_DIR / "smart-config-history.jsonl"

SMARTCTL = shutil.which("smartctl") or "/usr/sbin/smartctl"
SMARTD = shutil.which("smartd") or "/usr/sbin/smartd"
SYSTEMCTL = shutil.which("systemctl") or "/usr/bin/systemctl"
LSBLK = shutil.which("lsblk") or "/usr/bin/lsblk"


def run(cmd, timeout=60):
    try:
        p = subprocess.run(
            cmd,
            text=True,
            capture_output=True,
            timeout=timeout,
            check=False,
        )
        return {
            "ok": p.returncode == 0,
            "rc": p.returncode,
            "out": p.stdout.strip(),
            "err": p.stderr.strip(),
        }
    except Exception as exc:
        return {
            "ok": False,
            "rc": 999,
            "out": "",
            "err": str(exc),
        }


def flatten(devices, parent=None):
    rows = []

    for item in devices or []:
        current = dict(item)
        current["_parent"] = parent
        rows.append(current)

        rows.extend(
            flatten(
                item.get("children") or [],
                item.get("name"),
            )
        )

    return rows


def lsblk_rows():
    result = run(
        [
            LSBLK,
            "-J",
            "-O",
            "-b",
        ],
        timeout=30,
    )

    if not result["ok"]:
        raise RuntimeError(
            result["err"] or "lsblk konnte nicht ausgeführt werden"
        )

    data = json.loads(result["out"] or "{}")
    return flatten(data.get("blockdevices") or [])


def normalize_mountpoints(value):
    if value is None:
        return []

    if isinstance(value, list):
        values = value
    else:
        values = [value]

    result = []

    for item in values:
        item = str(item or "").strip()

        if item and item not in result:
            result.append(item)

    return result


def disk_children(rows, disk_name):
    result = []

    children_by_parent = {}

    for row in rows:
        parent = row.get("_parent")

        if parent:
            children_by_parent.setdefault(parent, []).append(row)

    stack = list(children_by_parent.get(disk_name, []))

    while stack:
        row = stack.pop(0)
        result.append(row)
        stack.extend(children_by_parent.get(row.get("name"), []))

    return result


def choose_by_id(device_path, device_type):
    real_device = os.path.realpath(device_path)
    candidates = []

    for link in glob.glob("/dev/disk/by-id/*"):
        name = os.path.basename(link)

        if "-part" in name:
            continue

        try:
            if os.path.realpath(link) != real_device:
                continue
        except OSError:
            continue

        score = 0

        if device_type == "nvme":
            if name.startswith("nvme-") and not name.startswith("nvme-eui."):
                score += 100
            elif name.startswith("nvme-eui."):
                score += 30

        elif device_type == "sat":
            if name.startswith("ata-"):
                score += 100
            elif name.startswith("wwn-"):
                score += 40

        else:
            if name.startswith("scsi-"):
                score += 80
            elif name.startswith("wwn-"):
                score += 60
            elif name.startswith("ata-"):
                score += 50

        if "_part" not in name and "-part" not in name:
            score += 10

        candidates.append(
            (
                score,
                len(name),
                link,
            )
        )

    if not candidates:
        return device_path

    candidates.sort(
        key=lambda item: (
            -item[0],
            item[1],
            item[2],
        )
    )

    return candidates[0][2]


def smart_info(device, dev_type):
    command = [
        SMARTCTL,
        "-i",
    ]

    if dev_type:
        command += [
            "-d",
            dev_type,
        ]

    command.append(device)

    return run(
        command,
        timeout=25,
    )


def detect_smart_type(device, row):
    transport = str(row.get("tran") or "").lower()
    name = str(row.get("name") or "")
    subsystem = str(row.get("subsystems") or "").lower()

    if name.startswith("nvme"):
        return "nvme"

    sat_result = smart_info(device, "sat")
    sat_text = (
        sat_result["out"]
        + "\n"
        + sat_result["err"]
    ).lower()

    if sat_result["ok"] and (
        "ata version" in sat_text
        or "sata version" in sat_text
        or "device model" in sat_text
        or "model family" in sat_text
    ):
        return "sat"

    scan = run(
        [
            SMARTCTL,
            "--scan-open",
        ],
        timeout=35,
    )

    for line in scan["out"].splitlines():
        if not line.startswith(device + " "):
            continue

        match = re.search(
            r"\s-d\s+([^\s#]+)",
            line,
        )

        if match:
            detected = match.group(1)

            if detected == "scsi" and (
                transport in {
                    "sata",
                    "ata",
                }
                or "ata" in subsystem
            ):
                return "sat"

            return detected

    if transport in {
        "sata",
        "ata",
    }:
        return "sat"

    return "scsi"


def mount_display_name(mountpoint):
    mountpoint = str(mountpoint or "").strip()

    if mountpoint == "/":
        return "System"

    mountpoint = mountpoint.rstrip("/")

    if mountpoint == "":
        return ""

    special = {
        "/boot": "System",
        "/boot/efi": "System",
        "/srv/nextcloud-data": "Nextcloud",
    }

    if mountpoint in special:
        return special[mountpoint]

    return os.path.basename(mountpoint) or mountpoint


def preferred_name(row, children):
    mountpoints = []

    for source in [row] + children:
        mountpoints.extend(
            normalize_mountpoints(source.get("mountpoints"))
        )

        mountpoint = source.get("mountpoint")

        if mountpoint:
            mountpoints.extend(
                normalize_mountpoints(mountpoint)
            )

    mountpoints = list(dict.fromkeys(mountpoints))

    priorities = [
        "/",
        "/srv/nextcloud-data",
    ]

    for wanted in priorities:
        if wanted in mountpoints:
            return (
                mount_display_name(wanted),
                mountpoints,
            )

    for mountpoint in mountpoints:
        name = mount_display_name(mountpoint)

        if name and name != "System":
            return (
                name,
                mountpoints,
            )

    for source in [row] + children:
        label = str(source.get("label") or "").strip()

        if label:
            return (
                label,
                mountpoints,
            )

    model = str(row.get("model") or "").strip()

    if model:
        return (
            model,
            mountpoints,
        )

    return (
        str(row.get("name") or "Unbekannt"),
        mountpoints,
    )


def parse_existing_entries():
    if not SMARTD_CONF.exists():
        return []

    text = SMARTD_CONF.read_text(
        encoding="utf-8",
        errors="replace",
    )

    entries = []

    current_comment = ""

    for line in text.splitlines():
        stripped = line.strip()

        if stripped.startswith("# SMART:"):
            current_comment = stripped

        if not stripped.startswith("/dev/"):
            continue

        path = stripped.split()[0].rstrip("\\")
        by_id = os.path.basename(path)

        name = ""

        if "|" in current_comment:
            mount_part = current_comment.split("|", 1)[1]
            mount_part = mount_part.replace("Mount:", "").strip()

            if mount_part and mount_part != "kein Mountpunkt":
                name = mount_display_name(mount_part)

        entries.append(
            {
                "path": path,
                "id": by_id,
                "name": name or by_id,
                "comment": current_comment,
            }
        )

    return entries


def device_model(row):
    vendor = str(row.get("vendor") or "").strip()
    model = str(row.get("model") or "").strip()

    return " ".join(
        part
        for part in [
            vendor,
            model,
        ]
        if part
    )


def should_monitor(item):
    """Nur dauerhaft verfügbare Laufwerke in smartd.conf aufnehmen.

    Nicht gemountete USB-Datenträger sind typischerweise wechselbare
    Backupplatten. Sie bleiben in der Vorschau sichtbar, werden aber nicht
    dauerhaft registriert, da smartd sonst nach dem Abziehen scheitern kann.
    """
    if not item.get("smart_capable"):
        return False

    transport = str(item.get("transport") or "").lower()
    mountpoints = item.get("mountpoints") or []

    if transport == "usb" and not mountpoints:
        return False

    return True


def discover_devices():
    rows = lsblk_rows()
    devices = []

    for row in rows:
        if row.get("type") != "disk":
            continue

        name = str(row.get("name") or "")

        if not (
            name.startswith("sd")
            or name.startswith("hd")
            or name.startswith("nvme")
        ):
            continue

        device = str(
            row.get("path")
            or (
                "/dev/" + name
            )
        )

        children = disk_children(
            rows,
            name,
        )

        display_name, mountpoints = preferred_name(
            row,
            children,
        )

        dev_type = detect_smart_type(
            device,
            row,
        )

        by_id = choose_by_id(
            device,
            dev_type,
        )

        info = smart_info(
            device,
            dev_type,
        )

        info_text = (
            info["out"]
            + "\n"
            + info["err"]
        )

        smart_capable = info["ok"] or (
            "smart support is:" in info_text.lower()
            or "nvme version" in info_text.lower()
        )

        devices.append(
            {
                "name": display_name,
                "device": device,
                "by_id": by_id,
                "id": os.path.basename(by_id),
                "model": device_model(row),
                "serial": str(row.get("serial") or "").strip(),
                "size": int(row.get("size") or 0),
                "type": dev_type,
                "transport": str(row.get("tran") or "").strip(),
                "mountpoints": mountpoints,
                "smart_capable": smart_capable,
                "smart_info_rc": info["rc"],
                "smart_info_error": info["err"],
            }
        )

    for item in devices:
        item["managed"] = should_monitor(item)

        if item["managed"]:
            item["managed_reason"] = "Wird dauerhaft überwacht"
        elif (
            str(item.get("transport") or "").lower() == "usb"
            and not item.get("mountpoints")
        ):
            item["managed_reason"] = (
                "Nicht gemountetes USB-Laufwerk – nur temporär erkannt"
            )
        else:
            item["managed_reason"] = "Nicht dauerhaft überwachbar"

    devices.sort(
        key=lambda item: (
            item["name"].lower(),
            item["device"],
        )
    )

    return devices


def human_size(size):
    value = float(size or 0)
    units = [
        "B",
        "KB",
        "GB",
        "TB",
        "PB",
    ]

    index = 0

    while value >= 1024 and index < len(units) - 1:
        value /= 1024.0
        index += 1

    if index == 0:
        return f"{int(value)} {units[index]}"

    if value >= 10:
        return f"{value:.0f} {units[index]}"

    return f"{value:.1f} {units[index]}"


def build_config(devices):
    lines = [
        "###############################################################################",
        "# /etc/smartd.conf",
        "# Automatisch erzeugt durch Server Manager Speicherverwaltung",
        "# Erzeugt: "
        + datetime.datetime.now().astimezone().strftime(
            "%Y-%m-%d %H:%M:%S %Z"
        ),
        "###############################################################################",
        "",
    ]

    for item in devices:
        if not should_monitor(item):
            continue

        mount_text = (
            ",".join(item["mountpoints"])
            if item["mountpoints"]
            else "kein Mountpunkt"
        )

        lines.append(
            "# SMART: {} | Gerät: {} | Mount: {}".format(
                item["name"],
                item["device"],
                mount_text,
            )
        )

        first = item["by_id"]

        if item["type"]:
            first += " -d " + item["type"]

        lines.append(first + " \\")

        if item["type"] == "nvme":
            lines.append("  -a \\")
        else:
            lines.append("  -a -o on -S on \\")

        lines.append("  -s (S/../.././02) \\")
        lines.append("  -m root \\")
        lines.append(
            "  -M exec /usr/share/smartmontools/smartd-runner"
        )
        lines.append("")

    return "\n".join(lines).rstrip() + "\n"


def service_state():
    active = run(
        [
            SYSTEMCTL,
            "is-active",
            "smartmontools.service",
        ],
        timeout=15,
    )

    enabled = run(
        [
            SYSTEMCTL,
            "is-enabled",
            "smartmontools.service",
        ],
        timeout=15,
    )

    return {
        "active": active["out"] or "unknown",
        "enabled": enabled["out"] or "unknown",
    }


def load_history(limit=10):
    if not HISTORY_FILE.exists():
        return []

    rows = []

    for line in HISTORY_FILE.read_text(
        encoding="utf-8",
        errors="replace",
    ).splitlines():
        try:
            rows.append(json.loads(line))
        except Exception:
            continue

    return rows[-limit:][::-1]


def append_history(entry):
    HISTORY_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    with HISTORY_FILE.open(
        "a",
        encoding="utf-8",
    ) as handle:
        handle.write(
            json.dumps(
                entry,
                ensure_ascii=False,
            )
            + "\n"
        )


def compare(existing, devices):
    existing_by_id = {
        item["id"]: item
        for item in existing
    }

    current_by_id = {
        item["id"]: item
        for item in devices
        if should_monitor(item)
    }

    added = [
        current_by_id[key]
        for key in sorted(
            current_by_id.keys() - existing_by_id.keys()
        )
    ]

    removed = [
        existing_by_id[key]
        for key in sorted(
            existing_by_id.keys() - current_by_id.keys()
        )
    ]

    unchanged = [
        current_by_id[key]
        for key in sorted(
            existing_by_id.keys() & current_by_id.keys()
        )
    ]

    return (
        added,
        removed,
        unchanged,
    )


def main():
    devices = discover_devices()
    existing = parse_existing_entries()

    added, removed, unchanged = compare(
        existing,
        devices,
    )

    result = {
        "ok": True,
        "mode": MODE,
        "devices": devices,
        "existing_count": len(existing),
        "smart_count": len(
            [
                item
                for item in devices
                if should_monitor(item)
            ]
        ),
        "detected_count": len(devices),
        "added": added,
        "removed": removed,
        "unchanged": unchanged,
        "service": service_state(),
        "history": load_history(),
    }

    if MODE == "smart-preview":
        print(
            json.dumps(
                result,
                ensure_ascii=False,
            )
        )
        return

    config = build_config(devices)

    timestamp = datetime.datetime.now().strftime(
        "%Y-%m-%d_%H-%M-%S"
    )

    backup = Path(
        f"/etc/smartd.conf.server-manager.{timestamp}.bak"
    )

    temporary = None

    try:
        if SMARTD_CONF.exists():
            shutil.copy2(
                SMARTD_CONF,
                backup,
            )

        fd, temporary_name = tempfile.mkstemp(
            prefix="smartd.conf.server-manager.",
            dir="/etc",
            text=True,
        )

        temporary = Path(temporary_name)

        with os.fdopen(
            fd,
            "w",
            encoding="utf-8",
        ) as handle:
            handle.write(config)

        os.chmod(
            temporary,
            0o644,
        )

        validation = run(
            [
                SMARTD,
                "-q",
                "onecheck",
                "-c",
                str(temporary),
            ],
            timeout=120,
        )

        result["validation"] = validation

        if not validation["ok"]:
            raise RuntimeError(
                "SMART-Konfiguration ungültig: "
                + (
                    validation["err"]
                    or validation["out"]
                    or f"Exit-Code {validation['rc']}"
                )
            )

        os.replace(
            temporary,
            SMARTD_CONF,
        )

        temporary = None

        os.chmod(
            SMARTD_CONF,
            0o644,
        )

        restart = run(
            [
                SYSTEMCTL,
                "restart",
                "smartmontools.service",
            ],
            timeout=60,
        )

        result["restart"] = restart
        result["service"] = service_state()

        if not restart["ok"] or result["service"]["active"] != "active":
            raise RuntimeError(
                "smartmontools.service konnte nicht gestartet werden: "
                + (
                    restart["err"]
                    or restart["out"]
                    or result["service"]["active"]
                )
            )

        result["backup"] = str(backup) if backup.exists() else ""
        result["message"] = (
            "SMART-Konfiguration erfolgreich aktualisiert."
        )

        history_entry = {
            "timestamp": datetime.datetime.now().astimezone().isoformat(
                timespec="seconds"
            ),
            "status": "success",
            "devices": result["smart_count"],
            "added": len(added),
            "removed": len(removed),
            "backup": result["backup"],
        }

        append_history(history_entry)
        result["history"] = load_history()

    except Exception as exc:
        result["ok"] = False
        result["error"] = str(exc)

        if temporary and temporary.exists():
            temporary.unlink(
                missing_ok=True,
            )

        rollback_done = False

        if backup.exists():
            shutil.copy2(
                backup,
                SMARTD_CONF,
            )

            rollback = run(
                [
                    SYSTEMCTL,
                    "restart",
                    "smartmontools.service",
                ],
                timeout=60,
            )

            rollback_done = rollback["ok"]
            result["rollback"] = rollback

        result["rollback_done"] = rollback_done
        result["service"] = service_state()

        append_history(
            {
                "timestamp": datetime.datetime.now().astimezone().isoformat(
                    timespec="seconds"
                ),
                "status": "failed",
                "error": result["error"],
                "rollback": rollback_done,
            }
        )

        result["history"] = load_history()

    print(
        json.dumps(
            result,
            ensure_ascii=False,
        )
    )


try:
    main()
except Exception as exc:
    print(
        json.dumps(
            {
                "ok": False,
                "mode": MODE,
                "error": str(exc),
            },
            ensure_ascii=False,
        )
    )
    sys.exit(1)
PY

  exit $?
fi


